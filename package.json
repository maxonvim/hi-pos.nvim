{
  "name": "hi-pos.nvim",
  "version": "0.1.0",
  "private": true,
  "description": "Natural language part-of-speech highlighting for Neovim using compromise.",
  "bin": {
    "hi-pos": "bin/hi-pos.js"
  },
  "scripts": {
    "build": "esbuild js/hi-pos.js --bundle --platform=node --target=node18 --format=cjs --minify --banner:js='#!/usr/bin/env node' --outfile=bin/hi-pos.js",
    "test:helper": "node bin/hi-pos.js"
  },
  "devDependencies": {
    "compromise": "^14.14.4",
    "esbuild": "^0.25.0"
  }
}
